# ── Required ──────────────────────────────────────────────────────────────────
# Get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000

# ── Notifications (choose channels) ──────────────────────────────────────────
# Options: inapp, telegram, email   (comma-separated)
NOTIFY_CHANNELS=inapp

# ── Telegram Bot (optional) ───────────────────────────────────────────────────
# 1. Message @BotFather on Telegram → /newbot → copy token
# 2. Message @userinfobot to get your chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Email / SMTP (optional) ───────────────────────────────────────────────────
# Gmail: use an App Password (myaccount.google.com → Security → App passwords)
NOTIFY_SMTP_HOST=smtp.gmail.com
NOTIFY_SMTP_PORT=587
NOTIFY_SMTP_USER=you@gmail.com
NOTIFY_SMTP_PASS=your-app-password
NOTIFY_EMAIL_FROM=you@gmail.com
NOTIFY_EMAIL_TO=you@gmail.com
